{
   "name": "deploy-guide",
   "version": "1.3.0",
   "private": true,
   "description": "Step-by-step deployment guides for every platform and framework, checked by CI and published as a docs site.",
   "type": "module",
   "packageManager": "pnpm@11.28.1",
   "engines": {
      "node": ">=22.12"
   },
   "scripts": {
      "docs:dev": "vitepress dev",
      "docs:build": "vitepress build && node scripts/check-site.mjs",
      "docs:preview": "vitepress preview",
      "check": "pnpm run check:snippets && pnpm run check:tables",
      "check:snippets": "node scripts/check-snippets.mjs",
      "check:tables": "node scripts/gen-tables.mjs --check",
      "gen:tables": "node scripts/gen-tables.mjs",
      "check:prices": "node scripts/gen-tables.mjs --stale-days 90",
      "check:pins": "node scripts/check-pins.mjs",
      "smoke": "node scripts/smoke.mjs",
      "screenshots": "node scripts/screenshots.mjs"
   },
   "devDependencies": {
      "jsonc-parser": "3.3.1",
      "mermaid": "12.2.0",
      "playwright": "1.64.1",
      "smol-toml": "1.9.1",
      "vitepress": "1.6.4",
      "yaml": "2.9.1"
   }
}
